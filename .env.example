# Copy to .env for local development. Never commit .env or real credentials.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
DATA_DIR=server/data
UPLOAD_DIR=server/uploads
# Optional JSON array to customize the ordered stages and steps; blank uses the built-in workflow.
WORKFLOW_STAGES_JSON=

# Required before the server will start. Use a randomly generated secret of at least 32 characters.
AUTH_USERNAME=operator
AUTH_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional Aliyun OSS. Keep the bucket private and use a least-privilege RAM user.
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=casework

# AI is off unless explicitly enabled. Enabling means uploaded text can be sent to this authorized endpoint.
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
